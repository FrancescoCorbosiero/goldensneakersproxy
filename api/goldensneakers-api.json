{
  "swagger": "2.0",
  "info": {
    "title": "Golden Sneakers API",
    "description": "Welcome to the Golden Sneakers API documentation.\n\nTo use this API, you need to authenticate with a Bearer token.\n\nPlease contact the system administrator to generate a token for you.\nOnce you have the token, include it in the `Authorization` header with the prefix `Bearer `.\n\nExample:\n```\nAuthorization: Bearer your_token_here\n```\n",
    "termsOfService": "/static/assets/pdf/terms/api_usage_policy.pdf",
    "contact": {
      "email": "it@goldensneakers.net"
    },
    "extensions": {
      "x-samples-enabled": true,
      "x-samples-languages": [
        "curl",
        "python",
        "javascript",
        "node"
      ]
    },
    "version": "v1"
  },
  "host": "www.goldensneakers.net",
  "schemes": [
    "https"
  ],
  "basePath": "/api",
  "consumes": [
    "application/json",
    "application/xml"
  ],
  "produces": [
    "application/json",
    "application/xml"
  ],
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Enter your token with \"Bearer \" prefix"
    }
  },
  "security": [
    {
      "Bearer": []
    }
  ],
  "paths": {
    "/assortment-flat/": {
      "get": {
        "operationId": "assortment-flat_list",
        "summary": "Retrieve flat list of all available sizes as individual products",
        "description": "Retrieve a flat list of all available sizes as individual products. Each size variant is returned as a separate item, similar to a product feed. Use `markup_percentage` to add a percentage increase, `markup_fixed` to add a fixed amount, and `vat_percentage` to apply VAT to the offer price. Rounding options allow adjustment of the presented price. For Exposly users, an automatic 3% discount is applied to all prices.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "A search term.",
            "required": false,
            "type": "string"
          },
          {
            "name": "ordering",
            "in": "query",
            "description": "Which field to use when ordering the results.",
            "required": false,
            "type": "string"
          },
          {
            "name": "markup_percentage",
            "in": "query",
            "description": "Optional percentage markup to add to the offer price.",
            "required": false,
            "type": "number"
          },
          {
            "name": "markup_fixed",
            "in": "query",
            "description": "Optional fixed amount to add to the offer price.",
            "required": false,
            "type": "number"
          },
          {
            "name": "vat_percentage",
            "in": "query",
            "description": "Optional VAT percentage to apply to the offer price.",
            "required": false,
            "type": "number"
          },
          {
            "name": "rounding_type",
            "in": "query",
            "description": "Optional rounding type for the presented price. Options are:\\n- `none`: No rounding (default).\\n- `whole`: Round to the nearest whole number.\\n- `half`: Round to the nearest 0.5.\\n- `point_nine_nine`: Adjust the integer part to the nearest multiple of 10 ending in 9, then add 0.99 (e.g., 43.20 becomes 49.99).",
            "required": false,
            "type": "string",
            "enum": [
              "none",
              "whole",
              "half",
              "point_nine_nine"
            ],
            "default": "none"
          },
          {
            "name": "show_only_products_with_ean",
            "in": "query",
            "description": "If `true`, show only sizes with `barcode` (EAN).",
            "required": false,
            "type": "boolean"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FlatSize"
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "tags": [
          "assortment"
        ]
      },
      "parameters": []
    },
    "/assortment-flat/{id}/": {
      "get": {
        "operationId": "assortment-flat_read",
        "description": "",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/FlatSize"
            }
          }
        },
        "tags": [
          "assortment-flat"
        ]
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "string"
        }
      ]
    },
    "/assortment-size/": {
      "get": {
